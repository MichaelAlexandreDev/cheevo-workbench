# Local RAIntegration-style data produced while testing
RACache/

# Editors / tools
.vscode/
.idea/
.cache/
.claude/settings.local.json

# Read-only clones of upstream projects (RALibretro, RAIntegration, rcheevos) for reference
reference/

# Local game files and BIOS (kept outside version control)
.utils/
# gitignore patterns are case-sensitive: cover upper-case dumps too (e.g. SCPH1001.BIN)
*.BIN
*.CUE
*.CHD
*.ISO
*.IMG
*.PBP
SCPH*
