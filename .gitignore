# Build output
build/
build-*/
cmake-build-*/
compile_commands.json
*.o
*.a
*.so
*.AppImage

# Game data: never commit ROMs, disc images, BIOS or saves
*.bin
*.cue
*.chd
*.iso
*.img
*.pbp
*.ecm
*.m3u
*.sfc
*.smc
*.nes
*.gba
*.gb
*.gbc
